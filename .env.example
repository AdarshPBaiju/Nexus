# ==============================================================================
# Project Nexus — Cloud SaaS Environment Variables Configuration
# Copy to .env for local Docker Compose or deployment execution
# ==============================================================================

# Regional Deployment & Cell Topology
NEXUS_REGIONAL_CELL=ap-south-1
NEXUS_CELL_ID=cell-04-mumbai
NEXUS_ENVIRONMENT=production

# Core API Server & Django
PORT=8000
DJANGO_SETTINGS_MODULE=nexus_settings
DJANGO_SECRET_KEY=nexus_live_enterprise_secret_key_change_in_production
ALLOWED_HOSTS=*

# PostgreSQL 16 & PgBouncer Connection Pooling (Forced RLS)
POSTGRES_DB=nexus_regional
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nexus_dev_postgres_password
NEXUS_DATABASE_URL=postgresql://nexus_app_rw:nexus_dev_password@pgbouncer:6432/nexus_regional

# Redis Cache, Streams & Celery Broker
REDIS_PORT=6379
NEXUS_REDIS_URL=redis://redis:6379/0

# MinIO S3 Object Storage (8-Year WORM Fiscal Receipts)
MINIO_ROOT_USER=nexus_minio_admin
MINIO_ROOT_PASSWORD=nexus_minio_secret_key
NEXUS_MINIO_ENDPOINT=http://minio:9000
NEXUS_MINIO_ACCESS_KEY=nexus_minio_admin
NEXUS_MINIO_SECRET_KEY=nexus_minio_secret_key
NEXUS_WORM_BUCKET=nexus-fiscal-worm

# Next.js 15 Web Client
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=production

# Go Heavy Worker
WORKER_PORT=9090

# Security & KMS
KMS_MASTER_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/nexus-root-cell-kms
