{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Desktop",
  "version": "0.1.0",
  "identifier": "com.nexus.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus Commercial Workstation",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval'; connect-src 'self' https: wss: http://127.0.0.1:*;"
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["nexus"]
    }
  }
}
