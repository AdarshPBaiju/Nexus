#!/usr/bin/env sh
# Project Nexus Git Pre-Push Hook
# Enforces branch naming taxonomy before outbound transmission.

current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "main" ]; then
    echo "ERROR: Direct push to 'main' is strictly forbidden by Project Nexus governance." >&2
    exit 1
fi

python3 ops/ci/branch_check.py "$current_branch"
if [ $? -ne 0 ]; then
    echo "ERROR: Pre-push branch check rejected branch '$current_branch'." >&2
    exit 1
fi

exit 0
